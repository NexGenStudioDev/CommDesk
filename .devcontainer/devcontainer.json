{
    "name": "Tauri Dev Environment",
    "dockerComposeFile": "../docker/docker-compose.yml",
    "service": "tauri-app",
    "workspaceFolder": "/app",

    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer",
                "vadimcn.vscode-lldb",
                "tauri-apps.tauri-vscode",
                "esbenp.prettier-vscode",
                "dbaeumer.vscode-eslint"
            ]
        }
    },
    "remoteUser": "developer"
}